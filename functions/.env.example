# ========================================================
# SOVEREIGN CLOUD: BACKEND ENVIRONMENT VARIABLE TEMPLATE
# ========================================================
#
# DO NOT ADD REAL SECRETS TO THIS FILE. 
# This is a tracked template describing what variables are required.
# 
# For Local Development: Copy this to `.env.local`
# For Production: Copy this to `.env.production` 
# (Deploy via: firebase deploy --only functions)
# ========================================================

# 1. CORE AI ORCHESTRATION
# We strictly use specific, audited models.
OPENAI_KEY="sk-..."
AI_MODEL_FALLBACK="gpt-4o-mini"
VECTORDBS_URL="https://pinecone-indexer..."

# 2. STRIPE BILLING & COMPLIANCE TIER ENFORCEMENT
# Live mode starts with sk_live, Test mode starts with sk_test
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs obtained from your Stripe Dashboard
STRIPE_COMPANION_MONTHLY="price_1..."
STRIPE_COMPANION_YEARLY="price_1..."
STRIPE_PRO_MONTHLY="price_2..."
STRIPE_PRO_YEARLY="price_2..."
STRIPE_ENTERPRISE_MONTHLY="price_3..."
STRIPE_ENTERPRISE_YEARLY="price_3..."

# 3. ROUTING RESTRICTIONS
# Define exactly what client URLs are allowed to hit these functions.
# (Prevents unauthorized CORS execution).
APP_BASE_URL="https://giovanna.app"
ALLOWED_ORIGIN_DEV="http://localhost:5173"

# 4. COMPLIANCE & MLOPS LOGGING
# Enables verbose logging for SOC2 auditing (Set to false in high-volume prod to save DB writes)
AUDIT_MODE_ENABLED="true"
