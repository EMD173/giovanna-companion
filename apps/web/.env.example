# ========================================================
# SOVEREIGN CLOUD: FRONTEND ENVIRONMENT VARIABLE TEMPLATE
# ========================================================
#
# DO NOT ADD REAL SECRETS TO THIS FILE. 
# This is a tracked template describing what variables are required.
# 
# For Local Development: Copy this to `.env.local`
# For Production: Copy this to `.env.production` (Vercel reads this automatically)
# ========================================================

# 1. FIREBASE CLIENT CONFIGURATION
# Found in Firebase Console -> Project Settings -> General -> Your Apps
VITE_FIREBASE_API_KEY="AIzaSy... (Client-safe key)"
VITE_FIREBASE_AUTH_DOMAIN="giovanna-app-xyz.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="giovanna-app-xyz"
VITE_FIREBASE_STORAGE_BUCKET="giovanna-app-xyz.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# 2. APPLICATION ROUTING & IDENTITY
VITE_APP_NAME="Giovanna Companion"
VITE_APP_VERSION="1.0.0-sovereign"

# The base URL of the deployed application (used for redirects/sharing)
# Dev: http://localhost:5173 | Prod: https://giovanna.app
VITE_BASE_URL="http://localhost:5173"

# 3. DEVELOPMENT / DEMO BYPASS FLAGS
# NEVER set these to true in production.
# Bypasses authentication for rapid iteration
VITE_DEV_BYPASS="false"

# 4. EXPERIMENTAL FEATURES (Phase 3+)
# Toggles for features currently undergoing clinical validation
VITE_FEATURE_CLINIC_INTEGRATION="false"
VITE_FEATURE_ZKP_VAULT="true"
