# Giovanna Companion — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (.gitignore already excludes it).

# ============================================
# FIREBASE (Required)
# ============================================
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ============================================
# AI (Cloud Function — set server-side)
# ============================================
# The web app does NOT need the AI key directly.
# Put server-side secrets in functions/.env instead.

# ============================================
# STRIPE (Future — Payment Processing)
# ============================================
VITE_STRIPE_PUBLISHABLE_KEY=

# ============================================
# QUICK SETUP CHECKLIST
# ============================================
# 1. [ ] Copy this file to .env
# 2. [ ] Fill in Firebase project values from Firebase Console > Project Settings
# 3. [ ] Copy functions/.env.example to functions/.env and fill in server-side secrets
# 4. [ ] Deploy: firebase deploy --only functions
# 5. [ ] (Optional) Add Stripe publishable key when ready for client checkout UI
